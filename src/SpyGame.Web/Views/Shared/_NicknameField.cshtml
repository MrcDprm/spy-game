@model (string Name, string? Value, string Id)
@{
    // A logged-in player plays as their account; the name is shown but cannot be changed here.
    var account = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
}
<div class="field">
    <label for="@Model.Id">@T["form.nickname"]</label>
    @if (account is not null)
    {
        <input id="@Model.Id" name="@Model.Name" value="@account" readonly aria-describedby="@(Model.Id)-hint" />
        <p class="hint" id="@(Model.Id)-hint">@T["account.nicknameLocked"]</p>
    }
    else
    {
        <input id="@Model.Id" name="@Model.Name" value="@Model.Value" required minlength="3" maxlength="20"
               pattern="[a-z][a-z0-9]{2,19}" autocomplete="nickname" autocapitalize="none" autocorrect="off" spellcheck="false"
               data-nickname aria-describedby="@(Model.Id)-hint" />
        <p class="hint" id="@(Model.Id)-hint">@T["form.nickname.hint"]</p>
    }
</div>
