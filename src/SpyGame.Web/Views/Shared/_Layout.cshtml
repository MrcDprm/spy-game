@{
    var english = Culture.IsEnglish;
    // The language link returns to the same page without ?lang, so the cookie decides.
    var path = Seo.WithoutLang(Context.Request.Path, Context.Request.Query);
    var title = ViewData["Title"]?.ToString();
    // Pages listed in Seo.Pages set SeoKey; rooms, accounts and errors stay out of search.
    var seoKey = ViewData["SeoKey"] as string;
    var fullTitle = seoKey != null
        ? T[$"seo.{seoKey}.title"].Value
        : string.IsNullOrEmpty(title) ? "Casus" : title + " · Casus";
    var description = seoKey == "board" ? T["seo.board.description"].Value : T["meta.description"].Value;
    var pagePath = Context.Request.Path.Value is { Length: > 1 } p ? p.TrimEnd('/') : "/";
    var urlTr = Seo.PageUrl(pagePath, english: false);
    var urlEn = Seo.PageUrl(pagePath, english: true);
    var author = new Dictionary<string, object> { ["@type"] = "Person", ["name"] = "Miraç Deprem", ["url"] = "https://www.miracdeprem.com" };
    var jsonLd = seoKey switch
    {
        "home" => Seo.JsonLd(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "VideoGame",
            ["name"] = "Casus",
            ["url"] = english ? urlEn : urlTr,
            ["description"] = description,
            ["inLanguage"] = english ? "en" : "tr",
            ["genre"] = english ? "Party game" : "Parti oyunu",
            ["gamePlatform"] = "Web browser",
            ["playMode"] = "MultiPlayer",
            ["isAccessibleForFree"] = true,
            ["offers"] = new Dictionary<string, object> { ["@type"] = "Offer", ["price"] = "0", ["priceCurrency"] = "USD" },
            ["author"] = author,
        }),
        null => null,
        _ => Seo.JsonLd(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebPage",
            ["name"] = fullTitle,
            ["url"] = english ? urlEn : urlTr,
            ["description"] = description,
            ["inLanguage"] = english ? "en" : "tr",
            ["author"] = author,
        }),
    };
}
<!DOCTYPE html>
<html lang="@(english ? "en" : "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    @if (seoKey == null)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@(english ? urlEn : urlTr)" />
        <link rel="alternate" hreflang="tr" href="@urlTr" />
        <link rel="alternate" hreflang="en" href="@urlEn" />
        <link rel="alternate" hreflang="x-default" href="@urlTr" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Casus" />
        <meta property="og:title" content="@fullTitle" />
        <meta property="og:description" content="@description" />
        <meta property="og:url" content="@(english ? urlEn : urlTr)" />
        <meta property="og:image" content="@Seo.Image" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="@(english ? "en_US" : "tr_TR")" />
        <meta property="og:locale:alternate" content="@(english ? "tr_TR" : "en_US")" />
        <meta name="twitter:card" content="summary_large_image" />
        @* "!" keeps the script tag helper from encoding the + in the type *@
        <!script type="application/ld+json">@Html.Raw(jsonLd)</!script>
    }
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@T["nav.skip"]</a>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" href="/" aria-label="Casus">
                <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
                    <rect width="64" height="64" rx="14" fill="#121417" />
                    <path d="M21 38 L24 21 Q28 17.5 32 21 Q36 17.5 40 21 L43 38 Z" fill="#ece4d4" />
                    <path d="M22.2 31 H41.8 L42.5 36 H21.5 Z" fill="#e2483d" />
                    <ellipse cx="32" cy="40" rx="21" ry="5.5" fill="#ece4d4" />
                </svg>
                <span class="brand__name">casus</span>
            </a>
            <div class="toolbar">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if ((await AuthorizationService.AuthorizeAsync(User, SpyGame.Web.Controllers.AdminController.AdminPolicy)).Succeeded)
                    {
                        <a class="icon-btn icon-btn--text" href="/admin">@T["admin.title"]</a>
                    }
                    <span class="account-name mono" title="@T["account.signedInAs"]">@User.Identity.Name</span>
                    <form method="post" action="/account/logout" class="inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="icon-btn icon-btn--text">@T["account.logout"]</button>
                    </form>
                }
                else
                {
                    <a class="icon-btn icon-btn--text" href="/account/login">@T["account.login.title"]</a>
                }
                <a class="icon-btn lang" href="/lang/@(english ? "tr" : "en")?returnUrl=@Uri.EscapeDataString(path)"
                   lang="@(english ? "tr" : "en")" aria-label="@T["nav.language"]">@(english ? "TR" : "EN")</a>
                <button class="icon-btn" type="button" data-theme-toggle aria-label="@T["nav.theme"]">
                    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
                    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </div>
        </div>
    </header>

    <main id="main" class="container main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <p class="muted small">@T["footer.note"]</p>
            @* Every live project links to the others; the current one is highlighted. *@
            <nav class="footer-projects" aria-label="@T["footer.projects"]">
                <a href="https://zarf.miracdeprem.com">Zarf</a>
                <a href="https://brain.miracdeprem.com">Brain Weight</a>
                <a href="https://spygame.miracdeprem.com" aria-current="page">Casus</a>
                <a href="https://seans.miracdeprem.com">Seans</a>
                <a href="https://kvkk.miracdeprem.com">KVKK Assistant</a>
                <a href="https://crypto.miracdeprem.com">Crypto Toolkit</a>
                <a href="https://sahaf.miracdeprem.com">Sahaf</a>
                <a href="https://tictactoe.miracdeprem.com">Tic-Tac-Toe</a>
                <a href="https://hangman.miracdeprem.com">Hangman</a>
                <a href="https://quiz.miracdeprem.com">Quiz App</a>
                <a href="https://weather.miracdeprem.com">Weather App</a>
            </nav>
            <div class="footer-meta">
                <span>© 2026 Miraç Deprem</span>
                <a href="https://www.miracdeprem.com">@T["footer.portfolio"]</a>
                <a href="https://github.com/MrcDprm/spy-game">@T["footer.source"]</a>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
