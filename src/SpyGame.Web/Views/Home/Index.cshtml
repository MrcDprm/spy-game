@model SpyGame.Web.Models.ViewModels.HomeViewModel
@using SpyGame.Web.Models.Game
@{
    var english = Culture.IsEnglish;
}
<partial name="_Notice" />
<section class="hero">
    <p class="eyebrow">@T["home.eyebrow"]</p>
    <h1 class="hero__title">@T["home.title"]</h1>
    <p class="hero__lead">@T["home.lead"]</p>
    <a class="board-link" href="/leaderboard">@T["board.title"] →</a>
</section>

<div class="home-grid">
    <section class="card card--paper" aria-labelledby="create-title">
        <p class="stamp stamp--small" aria-hidden="true">@(english ? "Top secret" : "Çok gizli")</p>
        <h2 id="create-title">@T["home.create.title"]</h2>
        <p class="muted">@T["home.create.text"]</p>
        <partial name="_FormError" model="@Model.Error" />
        <form method="post" action="/rooms" class="form">
            @Html.AntiForgeryToken()
            <partial name="_NicknameField" model="@(("Create.Nickname", Model.Create.Nickname, "create-nick"))" />

            @{
                var chosen = Model.Create.PlaceIds.ToHashSet();
            }
            <fieldset class="field" data-places data-min="@WordBank.MinPlaces" data-restore="@(Model.Error is null ? "true" : "false")" data-total="@T["form.places.total"]">
                <legend>@T["form.places"]</legend>
                <p class="hint">@T["form.places.hint", WordBank.MinPlaces]</p>
                @foreach (var group in WordBank.Groups)
                {
                    <details class="place-group" data-group>
                        <summary>
                            <input type="checkbox" class="place-group__toggle" data-group-toggle hidden aria-label="@T["form.places.groupAll", group.Number]" />
                            <span class="place-group__name">@T["form.places.group", group.Number]</span>
                            <span class="place-group__count mono" data-group-count>@group.Words.Count(w => chosen.Contains(w.Id))/@group.Words.Count</span>
                        </summary>
                        <div class="chips">
                            @foreach (var place in group.Words)
                            {
                                <label class="chip">
                                    <input type="checkbox" name="Create.PlaceIds" value="@place.Id" checked="@chosen.Contains(place.Id)" />
                                    <span>@place.In(english ? "en" : "tr")</span>
                                </label>
                            }
                        </div>
                    </details>
                }
                <div class="chip-actions">
                    <button type="button" class="link-btn" data-places-all hidden>@T["form.places.all"]</button>
                    <button type="button" class="link-btn" data-places-none hidden>@T["form.places.none"]</button>
                    <span class="place-total" data-places-total aria-live="polite"></span>
                </div>
            </fieldset>

            <div class="field-row">
                <div class="field">
                    <label for="round">@T["form.round"]</label>
                    <select id="round" name="Create.RoundMinutes">
                        @for (var m = 1; m <= 15; m++)
                        {
                            <option value="@m" selected="@(Model.Create.RoundMinutes == m)">@T["form.round.minutes", m]</option>
                        }
                    </select>
                </div>
                <fieldset class="field">
                    <legend>@T["form.spies"]</legend>
                    <div class="segmented">
                        @for (var i = RoundRules.MinSpies; i <= RoundRules.MaxSpies; i++)
                        {
                            <label><input type="radio" name="Create.SpyCount" value="@i" checked="@(Model.Create.SpyCount == i)" /><span>@i</span></label>
                        }
                    </div>
                </fieldset>
            </div>
            <p class="hint">@T["form.spies.hint"]</p>
            <button type="submit" class="btn btn--block">@T["form.create"]</button>
        </form>
    </section>

    <section class="card" aria-labelledby="join-title">
        <h2 id="join-title">@T["home.join.title"]</h2>
        <p class="muted">@T["home.join.text"]</p>
        <form method="post" action="/join" class="form">
            @Html.AntiForgeryToken()
            <partial name="_NicknameField" model="@(("Nickname", Model.Join.Nickname, "join-nick"))" />
            <div class="field">
                <label for="join-code">@T["form.code"]</label>
                <input id="join-code" class="code-input" name="Code" value="@Model.Join.Code" required maxlength="8"
                       autocomplete="off" autocapitalize="characters" spellcheck="false" data-room-code aria-describedby="join-code-hint" />
                <p class="hint" id="join-code-hint">@T["form.code.hint"]</p>
            </div>
            <button type="submit" class="btn btn--ghost btn--block">@T["form.join"]</button>
        </form>
    </section>
</div>

<section class="how" aria-labelledby="how-title">
    <h2 id="how-title">@T["how.title"]</h2>
    <ol class="steps">
        @for (var i = 1; i <= 4; i++)
        {
            <li class="step">
                <span class="step__num" aria-hidden="true">0@(i)</span>
                <h3>@T[$"how.{i}.title"]</h3>
                <p class="muted">@T[$"how.{i}.text"]</p>
            </li>
        }
    </ol>
</section>
