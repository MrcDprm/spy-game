@model SpyGame.Web.Models.ViewModels.JoinRoomForm
@{
    ViewData["Title"] = T["join.title"];
}
<section class="narrow">
    <div class="card card--paper">
        <p class="eyebrow">@T["form.code"]: <span class="mono">@Model.Code</span></p>
        <h1>@T["join.title"]</h1>
        <p class="muted">@T["join.lead"]</p>
        <partial name="_FormError" model="@(ViewData["Error"] as string)" />
        <form method="post" action="/join" class="form">
            @Html.AntiForgeryToken()
            <partial name="_NicknameField" model="@(("Nickname", Model.Nickname, "join-nick"))" />
            <div class="field">
                <label for="join-code">@T["form.code"]</label>
                <input id="join-code" class="code-input" name="Code" value="@Model.Code" required maxlength="8"
                       autocomplete="off" autocapitalize="characters" spellcheck="false" data-room-code />
            </div>
            <button type="submit" class="btn btn--block">@T["form.join"]</button>
        </form>
    </div>
    <p class="center"><a href="/">@T["join.back"]</a></p>
</section>
