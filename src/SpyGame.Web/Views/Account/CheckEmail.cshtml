@{
    ViewData["Title"] = T["account.check.title"];
}
<section class="narrow">
    <div class="card card--paper">
        <p class="stamp">@T["account.check.stamp"]</p>
        <h1>@T["account.check.title"]</h1>
        <p>@T["account.check.text"]</p>
        <p class="muted small">@T["account.check.spam"]</p>
    </div>
    <p class="center"><a href="/">@T["error.home"]</a></p>
</section>
